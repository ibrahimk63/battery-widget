<Window x:Class="BatteryWidget.UI.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Widget — Topluluk Desteği"
        Width="490"
        Height="340"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F3F4F6"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#141821"
                BorderBrush="#252C3D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <StackPanel>
                <TextBlock Text="Cihaz Desteğini Birlikte Geliştirelim"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#F9FAFB"
                           Margin="0,0,0,10" />

                <TextBlock Text="Yeni kablosuz kulaklık, fare ve klavyelerin Battery Widget'a daha hızlı eklenebilmesi için tanınmayan USB alıcıların yalnızca teknik donanım kimliğini anonim olarak paylaşmak ister misiniz?"
                           FontSize="12.5"
                           Foreground="#D1D5DB"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Border Background="#0D1017"
                        BorderBrush="#262C3D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="• Sadece tanınmayan cihazın VID:PID kimliği ve paket boyutu paylaşılır."
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="• Kullanıcı adı, bilgisayar adı, IP veya kişisel dosya KESİNLİKLE toplanmaz."
                                   FontSize="11.5"
                                   Foreground="#22C55E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="• Bu tercihi istediğiniz zaman Ayarlar → Genel Ayarlar'dan değiştirebilirsiniz."
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hayır, Teşekkürler"
                    Click="Decline_Click"
                    Background="#232836"
                    Foreground="#E5E7EB"
                    BorderBrush="#374151"
                    BorderThickness="1"
                    Padding="14,8"
                    FontSize="12.5"
                    Cursor="Hand"
                    Margin="0,0,10,0" />
            <Button Content="Evet, Destek Ol (Anonim)"
                    Click="Accept_Click"
                    Background="#22C55E"
                    Foreground="#09110D"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Padding="16,8"
                    FontSize="12.5"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>

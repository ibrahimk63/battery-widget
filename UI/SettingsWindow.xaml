<Window x:Class="BatteryWidget.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Widget — Ayarlar &amp; HID Tanılama"
        Width="580"
        Height="460"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F3F4F6"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#232836" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F364A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B4258" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#22C55E" />
            <Setter Property="Foreground" Value="#09110D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#181C26" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Background="#181C26" BorderBrush="#262C3D" BorderThickness="1" Padding="14">
            <TabItem Header="Genel Ayarlar">
                <StackPanel Margin="6">
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="Widget her zaman üstte dursun" Margin="0,0,0,12" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Windows açılışında otomatik başlat" Margin="0,0,0,12" />
                    <CheckBox x:Name="LowBatteryNotifCheck" Content="Düşük pilde Windows bildirimi gönder" Margin="0,0,0,18" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Düşük Pil Eşiği (%):" VerticalAlignment="Center" />
                        <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="5" Maximum="40" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="ThresholdValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#22C55E" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tarama Sıklığı (CPU Opt.):" VerticalAlignment="Center" />
                        <Slider x:Name="IntervalSlider" Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="IntervalValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Widget Saydamlığı:" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.4" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="OpacityValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#F3F4F6" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Aygıt Tanılama">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="UniversalScanBtn" Content="Tüm Aygıtları Tara &amp; Tanıla" Style="{StaticResource DarkButton}" Click="UniversalScan_Click" Margin="0,0,8,0" />
                        <Button Content="Ham HID Listesi" Style="{StaticResource DarkButton}" Click="ScanHid_Click" Margin="0,0,8,0" />
                        <Button Content="Kopyala" Style="{StaticResource DarkButton}" Click="CopyHid_Click" />
                    </StackPanel>

                    <TextBox x:Name="HidReportBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11.5"
                             Background="#0D1017"
                             Foreground="#E5E7EB"
                             BorderBrush="#262C3D"
                             Padding="8"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Kaydet" Style="{StaticResource AccentButton}" Click="Save_Click" Width="96" Margin="0,0,8,0" />
            <Button Content="Kapat" Style="{StaticResource DarkButton}" Click="Close_Click" Width="84" />
        </StackPanel>
    </Grid>
</Window>

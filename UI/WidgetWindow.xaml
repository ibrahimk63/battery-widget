<Window x:Class="BatteryWidget.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Widget"
        SizeToContent="WidthAndHeight"
        MinWidth="288"
        MaxWidth="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="16"
            Background="#F00D1017"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            Padding="14,12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu Background="#181B24" Foreground="#F3F4F6" BorderBrush="#2D3343">
                <MenuItem Header="Şimdi Yenile" Click="Refresh_Click" />
                <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Her Zaman Üstte" IsCheckable="True" Click="AlwaysOnTop_Click" />
                <Separator />
                <MenuItem Header="Ayarlar &amp; HID Tanılama" Click="Settings_Click" />
                <MenuItem Header="Gizle (Sistem Tepsisi)" Click="Hide_Click" />
                <Separator />
                <MenuItem Header="Çıkış" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <!-- Top Bar -->
            <Grid Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="BATTERY DASHBOARD"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Content="↻" ToolTip="Yenile" Style="{StaticResource IconBtn}" Click="Refresh_Click" />
                <Button Grid.Column="2" Content="⚙" ToolTip="Ayarlar &amp; HID Tanılama" Style="{StaticResource IconBtn}" Click="Settings_Click" />
            </Grid>

            <!-- Side-by-side Radial Cards -->
            <WrapPanel x:Name="DevicesPanel" Orientation="Horizontal" HorizontalAlignment="Center" />

            <!-- Empty State -->
            <TextBlock x:Name="EmptyStateText"
                       Text="Cihazlar taranıyor..."
                       FontSize="12"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,8"
                       Visibility="Visible" />
        </StackPanel>
    </Border>
</Window>
